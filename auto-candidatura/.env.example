# Copie este arquivo para ".env" e preencha. O .env NUNCA vai pro git.

# OBRIGATÓRIO — token do Apify (a plataforma que coleta as vagas).
# Crie conta grátis em https://apify.com  →  Settings → Integrations → API token
APIFY_TOKEN=

# OPCIONAL — chave da Claude API (Anthropic).
# Deixe VAZIO pra usar o modo grátis (o app gera prompts pra você colar no
# claude.ai). Se um dia quiser que o app escreva os e-mails sozinho, cole a
# chave aqui: https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=
